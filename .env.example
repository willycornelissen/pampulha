# Configurações do Firebase para o projeto Pampulha
# Se estas variáveis não forem fornecidas, o aplicativo funciona automaticamente
# em Modo Local / Demonstração (armazenando dados em localStorage).

VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=pampulha.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pampulha
VITE_FIREBASE_STORAGE_BUCKET=pampulha.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
